---
// House ad for Sacred Sampling Solutions, built to match the brand's
// "Know what's in your home." creative: SSS lockup + gold tagline, big
// navy/blue headline, capability icons, blue pill CTA, full-bleed family
// photo, and a bottom trust strip. Shown on the dark Sacred Intel site as a
// bright branded ad block. `compact` (article pages) trims it down.
const { compact = false } = Astro.props;
const url =
  'https://www.sacredsamplingsolutions.com/kits.html?utm_source=sacredintel&utm_medium=house_ad&utm_campaign=test_kits';

const S = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"';

const caps = [
  { t: 'Water', d: 'Drinking &amp; well water',
    svg: `<svg ${S}><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/></svg>` },
  { t: 'Air', d: 'Indoor air quality',
    svg: `<svg ${S}><path d="M3 8h11a2.5 2.5 0 1 0-2.5-2.5"/><path d="M3 12h15a2.5 2.5 0 1 1-2.5 2.5"/><path d="M3 16h9a2 2 0 1 1-2 2"/></svg>` },
  { t: 'Dust &amp; Surfaces', d: 'Your home environment',
    svg: `<svg ${S}><path d="M4 11l8-6 8 6"/><path d="M6 10v9h12v-9"/><path d="M10 19v-5h4v5"/></svg>` },
  { t: 'Specialty', d: 'Cosmetics, materials &amp; more',
    svg: `<svg ${S}><path d="M12 3c4 4 6.5 7 6.5 10.5a6.5 6.5 0 0 1-13 0C5.5 10 8 7 12 3z"/><path d="M12 7c-2 2.4-3.5 4.4-3.5 6.5a3.5 3.5 0 0 0 3.5 3.5"/></svg>` },
];

const trust = [
  { t: 'Certified Laboratories',
    svg: `<svg ${S}><path d="M9 3h6"/><path d="M10 3v5l-4.6 8.3A2 2 0 0 0 7.2 20h9.6a2 2 0 0 0 1.8-3.7L14 8V3"/><path d="M7.5 15h9"/></svg>` },
  { t: 'EPA-Approved Methods',
    svg: `<svg ${S}><path d="M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6z"/><path d="M9.3 12.2l1.8 1.8 3.6-3.9"/></svg>` },
  { t: 'Easy-to-Read Results',
    svg: `<svg ${S}><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>` },
  { t: 'Fast, Secure Shipping',
    svg: `<svg ${S}><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>` },
];
---
<aside class:list={['sc', { compact }]}>
  <div class="sc-grid">
    <div class="sc-left">
      <div class="sc-head">
        <img class="sc-logo" src="/img/sss-logo.png" alt="Sacred Sampling Solutions" width="1980" height="550" />
        <span class="sc-tag">Science.<br />Service.<br />Protection.</span>
      </div>

      <h2>Know what's <span>in&nbsp;your&nbsp;home.</span></h2>
      <p>Certified-lab test kits for water, air, dust and surfaces — delivered to your door. Collect a sample, mail it back, and get answers you can trust.</p>

      <div class="sc-caps">
        {caps.map((c) => (
          <div class="sc-cap">
            <span class="sc-ic" set:html={c.svg} />
            <b set:html={c.t} />
            <span class="d" set:html={c.d} />
          </div>
        ))}
      </div>

      <a class="sc-btn" href={url} target="_blank" rel="noopener sponsored">Order a test kit →</a>

      <div class="sc-trust">
        {trust.map((t) => (
          <div class="sc-ti">
            <span set:html={t.svg} />
            <span>{t.t}</span>
          </div>
        ))}
      </div>
      <p class="sc-disc">Disclosure: Sacred Intel's founder operates Sacred Sampling Solutions.</p>
    </div>

    <div class="sc-right">
      <img src="/img/sss-kit-family.webp" alt="A family collecting a water sample at the kitchen sink with a Sacred Sampling Solutions test kit on the counter" loading="lazy" />
    </div>
  </div>
</aside>

<style>
  .sc {
    --nv: #0e2a4e; --b: #2f6fed; --gd: #c29a43;
    --ink: #0e2a4e; --ink2: #475569; --cap-bg: #e8f1fd;
    background: #fff; border-radius: 20px; overflow: hidden;
    border: 1px solid #e3eaf3;
    box-shadow: 0 26px 60px -30px rgba(15, 23, 42, 0.6);
  }
  .sc-grid { display: grid; grid-template-columns: 1.08fr 0.92fr; align-items: stretch; }
  @media (max-width: 820px) { .sc-grid { grid-template-columns: 1fr; } }

  .sc-left { padding: 40px 42px; display: flex; flex-direction: column; }
  .compact .sc-left { padding: 30px 30px; }
  @media (max-width: 560px) { .sc-left { padding: 28px 24px; } }

  /* Header lockup: logo + gold tagline */
  .sc-head { display: flex; align-items: center; gap: 20px; margin-bottom: 22px; }
  .sc-logo { height: 52px; width: auto; display: block; }
  .compact .sc-logo { height: 44px; }
  @media (max-width: 420px) { .sc-logo { height: 42px; } }
  .sc-tag {
    font-family: var(--sans); font-weight: 800; font-size: 0.74rem;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--gd);
    line-height: 1.5; padding-left: 20px; border-left: 1px solid #e3eaf3;
  }
  @media (max-width: 420px) { .sc-tag { font-size: 0.66rem; padding-left: 14px; gap: 10px; } }

  .sc h2 {
    font-family: var(--sans); font-weight: 800; color: var(--nv);
    font-size: clamp(2rem, 3.6vw, 3rem); line-height: 1.02;
    letter-spacing: -0.025em; margin: 4px 0 16px;
  }
  .sc h2 span { color: var(--b); }
  .compact .sc h2 { font-size: clamp(1.7rem, 3vw, 2.2rem); }

  .sc p { font-family: var(--sans); color: var(--ink2); font-size: 1.03rem; line-height: 1.5; margin: 0 0 26px; max-width: 46ch; }

  /* Capability row */
  .sc-caps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 0 0 30px; }
  @media (max-width: 480px) { .sc-caps { grid-template-columns: repeat(2, 1fr); gap: 20px 14px; } }
  .sc-cap { text-align: left; }
  .sc-ic {
    display: grid; place-items: center; width: 54px; height: 54px;
    border-radius: 50%; background: var(--cap-bg); color: var(--b); margin-bottom: 10px;
  }
  .sc-ic :global(svg) { width: 26px; height: 26px; }
  .sc-cap b { display: block; font-family: var(--sans); font-size: 0.82rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--nv); line-height: 1.2; }
  .sc-cap .d { display: block; font-family: var(--sans); font-size: 0.82rem; line-height: 1.3; color: var(--ink2); margin-top: 3px; }

  /* CTA */
  .sc-btn {
    display: inline-flex; align-items: center; gap: 8px; align-self: flex-start;
    background: var(--b); color: #fff; font-family: var(--sans); font-weight: 700;
    font-size: 1.1rem; padding: 0.92em 2em; border-radius: 999px;
    box-shadow: 0 14px 30px -12px rgba(47, 111, 237, 0.7);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .sc-btn:hover { background: var(--nv); transform: translateY(-1px); }

  /* Trust strip */
  .sc-trust {
    display: grid; grid-template-columns: repeat(4, auto); justify-content: start;
    gap: 0; margin-top: 30px; padding-top: 22px; border-top: 1px solid #eef2f7;
  }
  .compact .sc-trust { display: none; }
  @media (max-width: 480px) { .sc-trust { grid-template-columns: 1fr 1fr; gap: 16px 0; } }
  .sc-ti { display: flex; align-items: center; gap: 8px; padding: 0 15px; color: var(--nv); position: relative; }
  .sc-ti:first-child { padding-left: 0; }
  .sc-ti + .sc-ti::before { content: ""; position: absolute; left: 0; top: 10%; bottom: 10%; width: 1px; background: #e3eaf3; }
  @media (max-width: 480px) { .sc-ti { padding: 0; } .sc-ti + .sc-ti::before { display: none; } .sc-ti:nth-child(even) { padding-left: 16px; } }
  .sc-ti :global(svg) { width: 21px; height: 21px; flex: none; color: var(--b); }
  .sc-ti span:last-child { font-family: var(--sans); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.01em; text-transform: uppercase; line-height: 1.2; }

  .sc-disc { font-size: 0.74rem !important; color: #94a3b8 !important; margin: 18px 0 0 !important; }

  /* Full-bleed photo */
  .sc-right { position: relative; min-height: 100%; background: #eef2f7; }
  .sc-right img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 62%; display: block; }
  @media (max-width: 820px) {
    .sc-right { min-height: 300px; order: -1; }
    .sc-right img { position: relative; height: 300px; }
  }
  @media (max-width: 480px) { .sc-right, .sc-right img { min-height: 230px; height: 230px; } }

  /* Compact phone layout — fit the ad within a single screen */
  @media (max-width: 560px) {
    .sc-left { padding: 18px 22px 18px; }
    .sc-right, .sc-right img { min-height: 130px; height: 130px; }
    .sc-right img { object-position: center 55%; }
    .sc-head { margin-bottom: 12px; gap: 14px; }
    .sc-logo { height: 38px; }
    .sc-tag { font-size: 0.6rem; padding-left: 12px; line-height: 1.4; }
    .sc h2 { font-size: 1.6rem; margin: 2px 0 10px; }
    .sc p { font-size: 0.88rem; line-height: 1.38; margin: 0 0 14px; }
    .sc-caps { grid-template-columns: repeat(2, 1fr); gap: 12px 14px; margin: 0 0 14px; }
    .sc-ic { width: 40px; height: 40px; margin-bottom: 6px; }
    .sc-ic :global(svg) { width: 20px; height: 20px; }
    .sc-cap b { font-size: 0.72rem; }
    .sc-cap .d { display: none; }
    .sc-btn { font-size: 0.98rem; padding: 0.76em 1.5em; box-shadow: 0 10px 22px -12px rgba(47,111,237,0.7); }
    .sc-trust { grid-template-columns: 1fr 1fr; gap: 10px 0; margin-top: 12px; padding-top: 12px; }
    .sc-ti :global(svg) { width: 18px; height: 18px; }
    .sc-ti span:last-child { font-size: 0.64rem; }
    .sc-disc { font-size: 0.64rem !important; margin: 10px 0 0 !important; }
  }
</style>
