---
const {
  title = 'Get the stories that matter',
  text = 'Independent reporting, data updates, and new investigations — straight to your inbox. Free. No noise.',
} = Astro.props;
---
<div class="newsletter">
  <span class="eyebrow">The Intel Brief</span>
  <h2>{title}</h2>
  <p>{text}</p>
  <form class="nl-form" action="#" method="post" novalidate>
    <input type="email" name="email" placeholder="you@email.com" aria-label="Email address" required />
    <button type="submit" class="btn btn-primary">Subscribe</button>
  </form>
</div>
