---
import { SITE } from '../lib/site.js';
import { SECTIONS } from '../lib/sections.js';
const year = new Date().getFullYear();
const standards = [
  ['Editorial Standards', '/standards/#editorial'],
  ['Corrections Policy', '/standards/#corrections'],
  ['Ethics & Independence', '/standards/#ethics'],
  ['Source Policy', '/standards/#sources'],
  ['Fact-Checking', '/standards/#fact-checking'],
  ['AI Policy', '/standards/#ai'],
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="brand" href="/" style="color:#fff">
          <img src="/favicon.svg" alt="" width="30" height="30" />
          <span class="bt">Sacred Intel</span>
        </a>
        <p class="foot-about">Independent journalism for a safer, more informed world — safety, science, engineering, and environmental health.</p>
        <div class="subscribe">{SITE.subscribe.slice(0, 3).map((s) => <a href={s.href}>{s.name}</a>)}</div>
      </div>
      <div>
        <h4>Reporting</h4>
        <a href="/latest/">Latest</a>
        <a href="/investigations/">Investigations</a>
        {SECTIONS.map((s) => <a href={`/section/${s.slug}/`}>{s.name}</a>)}
      </div>
      <div>
        <h4>Standards</h4>
        {standards.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
      <div>
        <h4>Sacred Intel</h4>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a href="/guests/">Become a Guest</a>
        <a href="/episodes/">Podcast</a>
        <a href="/lookup/">Check Your Area</a>
      </div>
      <div>
        <h4>Follow</h4>
        {SITE.social.map((s) => <a href={s.href}>{s.name}</a>)}
        <a href="/podcast.xml">RSS</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; {year} Sacred Intel. All rights reserved.</span>
      <span class="mono">Independent media · Reported &amp; sourced</span>
    </div>
  </div>
</footer>
