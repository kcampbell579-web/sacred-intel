---
import { SITE } from '../lib/site.js';
import { SECTIONS } from '../lib/sections.js';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-brand">
      <a class="wordmark" href="/">SACRED <span class="intel">INTEL</span></a>
      <span class="fline">Environmental health. Public safety. Real impact.</span>
    </div>
    <div class="foot-grid">
      <div>
        <h4>Sections</h4>
        <a href="/latest/">News</a>
        {SECTIONS.map((s) => <a href={`/section/${s.slug}/`}>{s.name}</a>)}
        <a href="/investigations/">Investigations</a>
      </div>
      <div>
        <h4>Explore</h4>
        <a href="/data/">Data &amp; Tools</a>
        <a href="/watch/">Watch + Listen</a>
        <a href="/episodes/">Podcast</a>
        <a href="/#intel-brief">Newsletter</a>
        <a href="/series/disaster-files/">Series</a>
      </div>
      <div>
        <h4>About</h4>
        <a href="/about/">Our Team</a>
        <a href="/standards/">Editorial Standards</a>
        <a href="/standards/#sources">Sources &amp; Methodology</a>
        <a href="/standards/#corrections">Corrections Policy</a>
        <a href="/contact/">Contact</a>
        <a href="/contact/">Submit a Tip</a>
      </div>
      <div>
        <h4>Follow</h4>
        <a href="#">Instagram</a>
        <a href="#">YouTube</a>
        <a href="#">LinkedIn</a>
        <a href="#">X</a>
        <a href="/podcast.xml">RSS</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; {year} Sacred Intel · A safer, healthier, more informed tomorrow.</span>
      <span>Independent media · Reported &amp; sourced · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></span>
    </div>
  </div>
</footer>
