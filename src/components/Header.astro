---
import { SECTIONS } from '../lib/sections.js';
const path = Astro.url.pathname;
const on = (href) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Sacred Intel home">
      <img src="/favicon.svg" alt="" width="30" height="30" />
      <span class="bt">Sacred Intel<small>Safety · Science · Failure</small></span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <a href="/latest/" class={on('/latest') ? 'active' : ''}>Latest</a>
      <a href="/investigations/" class={on('/investigations') ? 'active' : ''}>Investigations</a>
      {SECTIONS.map((s) => (
        <a href={`/section/${s.slug}/`} class={path.startsWith(`/section/${s.slug}`) ? 'active' : ''}>{s.name}</a>
      ))}
      <a href="/episodes/" class={on('/episodes') ? 'active' : ''}>Podcast</a>
      <a href="/lookup/" class={on('/lookup') ? 'active' : ''}>Check Your Area</a>
    </nav>

    <div class="nav-cta">
      <a href="/about/" class="btn btn-ghost btn-sm hide-sm">About</a>
      <a href="/#intel-brief" class="btn btn-primary btn-sm hide-sm">Subscribe</a>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    <a href="/latest/">Latest</a>
    <a href="/investigations/">Investigations</a>
    <div class="grp">Sections</div>
    {SECTIONS.map((s) => <a href={`/section/${s.slug}/`}>{s.name}</a>)}
    <div class="grp">More</div>
    <a href="/episodes/">Podcast</a>
    <a href="/lookup/">Check Your Area</a>
    <a href="/about/">About</a>
    <a href="/contact/">Contact</a>
  </div>
</header>

<script>
  const t = document.getElementById('navToggle');
  const m = document.getElementById('mobileMenu');
  t?.addEventListener('click', () => {
    const open = m.classList.toggle('open');
    t.setAttribute('aria-expanded', String(open));
  });
</script>
