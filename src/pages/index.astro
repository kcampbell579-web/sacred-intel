---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { articleImage, episodeImage } from '../lib/images.js';
import { sectionOf, sectionBySlug, isInvestigation, SECTIONS } from '../lib/sections.js';
import { readingTime, fmtDate, fmtDateLong } from '../lib/format.js';
import { seriesList } from '../lib/series.js';

const articles = (await getCollection('articles', (a) => !a.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const lead = articles[0];
const leadSec = sectionBySlug[sectionOf(lead)];
const leadPhoto = lead.data.image || articleImage(lead.slug);
const leadIsInv = isInvestigation(lead);

const mostRead = articles.slice(1, 6);

// one latest story per section for the grid
const topGrid = SECTIONS.map((s) => articles.find((a) => a.slug !== lead.slug && sectionOf(a) === s.slug)).filter(Boolean);
const gridSlugs = new Set([lead.slug, ...topGrid.map((a) => a.slug)]);
const theLatest = articles.filter((a) => !gridSlugs.has(a.slug)).slice(0, 6);

const episodes = (await getCollection('episodes', (e) => !e.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featEp = episodes.find((e) => e.data.featured) || episodes[0];
const sideEps = episodes.filter((e) => e.slug !== featEp?.slug).slice(0, 3);

const tools = [
  ['Contamination Lookup', '/data/'],
  ['Superfund Sites', '/data/'],
  ['What Was Here Before?', '/data/'],
  ['Drinking Water Data', '/data/'],
  ['Air Quality', '/data/'],
  ['Industrial Facilities', '/data/'],
];
---
<Base>
  <!-- Hero: feature + Most Read -->
  <section class="hero-wrap">
    <div class="feature">
      {leadPhoto ? <img src={leadPhoto} alt={lead.data.title} /> : <div class="ph"></div>}
      <div class="scrim"></div>
      <div class="fc">
        <span class="cat-label" style={`--dot:${leadIsInv ? 'var(--purple)' : leadSec.color}`}>{leadIsInv ? 'Investigation' : leadSec.name}</span>
        <h1><a href={`/articles/${lead.slug}/`}>{lead.data.title}</a></h1>
        <p class="deck">{lead.data.description}</p>
        <div class="meta"><span>By {lead.data.author.split(',')[0]}</span><span class="sep">|</span><span>{fmtDate(lead.data.date)}</span><span class="sep">|</span><span>{readingTime(lead)} min read</span></div>
        <a href={`/articles/${lead.slug}/`} class="btn btn-primary btn-lg">{leadIsInv ? 'Read the investigation' : 'Read the story'} →</a>
      </div>
    </div>

    <aside class="mostread">
      <h3>Most Read</h3>
      <ol>
        {mostRead.map((a, i) => {
          const s = sectionBySlug[sectionOf(a)];
          return (
            <li>
              <span class="rank">{i + 1}</span>
              <div>
                <a class="rl" href={`/articles/${a.slug}/`}>{a.data.title}</a>
                <span class="rm">{s.name} · {readingTime(a)} min read</span>
              </div>
            </li>
          );
        })}
      </ol>
      <div class="nl-mini">
        <h4>Get the stories that matter.</h4>
        <p>Independent reporting and new investigations, straight to your inbox.</p>
        <form action="#" method="post" novalidate>
          <input type="email" placeholder="you@email.com" aria-label="Email" required />
          <button class="btn btn-primary btn-sm" type="submit">Subscribe</button>
        </form>
      </div>
    </aside>
  </section>

  <!-- Top story grid -->
  <section class="section">
    <div class="wrap">
      <div class="rulehead"><h2>Top Stories</h2><a class="more" href="/latest/">All reporting →</a></div>
      <div class="grid grid-4">
        {topGrid.map((a) => <ArticleCard article={a} />)}
      </div>
    </div>
  </section>

  <!-- Data & Tools -->
  <section class="section datatools">
    <div class="wrap">
      <div class="dt-grid">
        <div class="dt-copy">
          <span class="eyebrow">Data &amp; Tools</span>
          <h2>Explore your area</h2>
          <p>Search your ZIP code to find potential environmental risks, nearby facilities, and the records that describe what's in your air and water.</p>
          <form class="zipbar" action="/data/" method="get">
            <input type="text" name="zip" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" placeholder="Enter ZIP code" aria-label="ZIP code" />
            <button class="btn btn-primary" type="submit">→</button>
          </form>
          <div class="dt-tools">
            {tools.map(([label, href], i) => (
              <a href={href}><span class="n">{String(i + 1).padStart(2, '0')}</span> {label}</a>
            ))}
          </div>
        </div>
        <div class="dt-map" aria-hidden="true">
          <svg viewBox="0 0 400 275" preserveAspectRatio="xMidYMid meet">
            <rect width="400" height="275" fill="#0d0e13"></rect>
            {Array.from({ length: 46 }).map((_, i) => {
              const x = 30 + ((i * 71) % 340) + ((i % 5) * 7);
              const y = 30 + ((i * 43) % 210) + ((i % 3) * 6);
              const r = 1.5 + (i % 4);
              const op = 0.25 + ((i % 5) * 0.15);
              return <circle cx={x} cy={y} r={r} fill="#8b5cf6" opacity={op}></circle>;
            })}
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- The Latest feed -->
  <section class="section">
    <div class="wrap">
      <div class="rulehead"><h2>The Latest</h2><a class="more" href="/latest/">View all stories →</a></div>
      <div class="feed">
        {theLatest.map((a) => {
          const s = sectionBySlug[sectionOf(a)];
          const ph = a.data.image || articleImage(a.slug);
          return (
            <div class="row">
              <a href={`/articles/${a.slug}/`} class:list={['thumb', { ph: !ph }]} style={`--dot:${s.color}`}>{ph && <img src={ph} alt={a.data.title} loading="lazy" />}</a>
              <div>
                <span class="cat-label" style={`--dot:${s.color}`}>{s.name}</span>
                <h3><a href={`/articles/${a.slug}/`}>{a.data.title}</a></h3>
                <p>{a.data.description}</p>
                <div class="meta"><span>{fmtDate(a.data.date)}</span><span class="sep">·</span><span>{readingTime(a)} min read</span></div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Watch + Listen -->
  <section class="section section-surface">
    <div class="wrap">
      <div class="rulehead"><h2>Watch + Listen</h2><a class="more" href="/watch/">All episodes →</a></div>
      <div class="watch-grid">
        {featEp && (
          <div class="watch-lead">
            <a href={`/episodes/${featEp.slug}/`} class="art">
              {episodeImage(featEp.slug) && <img src={episodeImage(featEp.slug)} alt={featEp.data.title} />}
              <span class="play"><span><svg width="22" height="22" viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg></span></span>
            </a>
            <span class="cat-label" style="--dot:var(--purple);margin-top:14px">Video &amp; Podcast</span>
            <h3><a href={`/episodes/${featEp.slug}/`} style="color:var(--text)">{featEp.data.title}</a></h3>
            <p class="muted">{featEp.data.description}</p>
          </div>
        )}
        <div class="watch-side">
          {sideEps.map((e) => (
            <a class="witem" href={`/episodes/${e.slug}/`}>
              <div class="wthumb">{episodeImage(e.slug) && <img src={episodeImage(e.slug)} alt={e.data.title} />}</div>
              <div><span class="cat-label" style="--dot:var(--purple)">Watch · Listen</span><h4>{e.data.title}</h4></div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Series -->
  <section class="section">
    <div class="wrap">
      <div class="rulehead"><h2>Sacred Intel Series</h2><a class="more" href="/series/disaster-files/">Explore →</a></div>
      <div class="grid grid-3" style="background:none;border:none;gap:20px">
        {seriesList.map((s) => (
          <a class="series-card" href={`/series/${s.slug}/`} style={`--dot:${s.color}`}>
            <span class="eyebrow">Series</span><h3>{s.name}</h3><p>{s.blurb.split('—')[0]}</p><span class="arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Intel Brief -->
  <section class="section section-surface" id="intel-brief">
    <div class="wrap"><Newsletter /></div>
  </section>
</Base>
