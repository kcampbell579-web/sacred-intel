---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site.js';

const {
  title,
  description = SITE.description,
  image = '/og-default.jpg',
  type = 'website',
  jsonld = null,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — Independent investigative news`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const org = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: 'Sacred Intel',
  url: Astro.site?.toString(),
  slogan: 'Real stories. Researched truth. A safer tomorrow.',
  logo: new URL('/favicon.svg', Astro.site).toString(),
  sameAs: ['https://instagram.com', 'https://youtube.com', 'https://x.com'],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#090a0d" />
  <meta name="color-scheme" content="dark" />

  <!-- Google tag (gtag.js) — GA4 G-B3VGFV0W3Q + Google Ads AW-18453981424 -->
  <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-B3VGFV0W3Q"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-B3VGFV0W3Q');
    gtag('config', 'AW-18453981424');
  </script>

  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Sacred Intel" href="/rss.xml" />
  <link rel="alternate" type="application/rss+xml" title="Sacred Intel Podcast" href="/podcast.xml" />

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <script>
    // Newsletter signup → POST to our /api/subscribe function, which adds the
    // address to a Mailjet contact list. Confirms (or shows an error) in place,
    // with no page reload. Falls back to a native POST if JS is unavailable.
    // To count subscribes as a Google Ads conversion, paste your conversion
    // label below, e.g. 'AW-18453981424/AbCdEfG...'.
    const SUB_CONVERSION = '';
    document.querySelectorAll('form[data-newsletter]').forEach((f) => {
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = f.querySelector('input[type="email"]');
        const email = (input && input.value || '').trim();
        const btn = f.querySelector('button');
        if (!email) { input && input.focus(); return; }
        const endpoint = f.getAttribute('action') || '/api/subscribe';
        const orig = btn ? btn.textContent : '';
        if (btn) { btn.disabled = true; btn.textContent = 'Subscribing…'; }
        const fail = (msg) => {
          if (btn) { btn.disabled = false; btn.textContent = orig; }
          let m = f.querySelector('.nl-err');
          if (!m) { m = document.createElement('p'); m.className = 'nl-err'; m.style.cssText = 'margin:10px 0 0;color:#f2a59d;font-size:0.85rem'; f.appendChild(m); }
          m.textContent = msg;
        };
        try {
          const r = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ email }),
          });
          const data = await r.json().catch(() => ({}));
          if (r.ok && data.ok) {
            f.innerHTML = '<p style="margin:0;color:var(--text-2)">Thanks — you’re on the list. Check your inbox to confirm.</p>';
            if (SUB_CONVERSION && typeof window.gtag === 'function') {
              window.gtag('event', 'conversion', { send_to: SUB_CONVERSION });
            }
          } else {
            fail((data && data.error) || 'That didn’t go through. Please try again.');
          }
        } catch (_) {
          fail('Network error — please try again.');
        }
      });
    });
  </script>
</body>
</html>
